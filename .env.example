# Server-only Supabase config (not exposed to the browser)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key

# HMAC secret for I-Card QR verification (32+ random characters)
QR_SIGNING_SECRET=your-random-32-char-secret-here

# Cron + reminders (Vercel sets CRON_SECRET automatically on Pro; set manually for Hobby)
CRON_SECRET=your-random-cron-secret

# Optional: full auth user deletion from admin panel (Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: canonical app URL for QR links (defaults to VERCEL_URL or localhost)
NEXT_PUBLIC_APP_URL=https://sns-vol.vercel.app

# Demo login accounts (see lib/demo-accounts.ts)
# demo-admin@sns-vol.demo / demo-organiser@sns-vol.demo / demo-volunteer@sns-vol.demo
# Password: SnsDemo2026!
