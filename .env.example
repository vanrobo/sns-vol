# Server-only Supabase config (not exposed to the browser)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key

# HMAC secret for I-Card QR verification (32+ random characters)
QR_SIGNING_SECRET=your-random-32-char-secret-here

# Optional: canonical app URL for QR links (defaults to VERCEL_URL or localhost)
NEXT_PUBLIC_APP_URL=https://sns-vol.vercel.app

