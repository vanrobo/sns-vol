# Server-only Supabase config (not exposed to the browser)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key

# HMAC secret for I-Card QR verification (32+ random characters)
QR_SIGNING_SECRET=your-random-32-char-secret-here

# Cron + reminders (set manually; Vercel Pro can use built-in cron)
CRON_SECRET=your-random-cron-secret

# Full auth user deletion from admin panel + reliable cron inserts
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical app URL for QR links (production)
NEXT_PUBLIC_APP_URL=https://sns-vol.vercel.app

# Rate limiting (optional — free tier at https://upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Error monitoring (optional — https://sentry.io)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Demo login banner on /login (optional)
# NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=true

# Demo accounts (migration 003 / lib/demo-accounts.ts) — kept for training
# demo-admin@sns-vol.demo / demo-organiser@sns-vol.demo / demo-volunteer@sns-vol.demo
# Password: SnsDemo2026!
